# BOOKORA AI — environment template
# Copy to .env and fill in with your own backend/project values.
# NEVER commit a real .env file or paste private credentials into source control.

# --- Client-visible (safe to expose in the browser) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Server-only ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-id"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Service-role keys bypass RLS. Keep them only in server/worker secret stores.

# --- AI runtime ---
# Legacy switch (still supported): cloud = Lovable AI Gateway; local = Ollama-style runtime.
# The local path is CPU-first and does not require CUDA/GPU.
AI_RUNTIME_MODE="cloud"
AI_MODEL=""
LOVABLE_API_KEY=""

# Preferred provider selection (overrides AI_RUNTIME_MODE when set):
#   "lovable"            -> Lovable AI Gateway (default cloud)
#   "ollama"             -> local OpenAI-compatible runtime (CPU-first, e.g. Ollama)
#   "openai-compatible"  -> any OpenAI-compatible endpoint (set AI_BASE_URL + AI_API_KEY)
# AI_PROVIDER="lovable"

# Endpoint overrides. LOCAL_AI_BASE_URL/LOCAL_AI_MODEL take precedence over the
# legacy AI_LOCAL_BASE_URL/AI_LOCAL_MODEL names.
# AI_BASE_URL=""            # required for AI_PROVIDER=openai-compatible
# AI_API_KEY=""             # for AI_PROVIDER=openai-compatible (server-only)
LOCAL_AI_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_AI_MODEL="qwen-1.5b"
# Optional if your local OpenAI-compatible server requires a key.
# AI_LOCAL_API_KEY=""

# AI request hardening (server-only): per-request timeout and retry budget.
# AI_TIMEOUT_MS="30000"
# AI_MAX_RETRIES="2"

# --- Worker-only secrets (keep out of browser-visible variables) ---
# BOOKORA_WORKER_SECRET="generate-a-long-random-secret"
# SUPABASE_SERVICE_ROLE_KEY="..."
# HF_TOKEN="..." # only if a selected training base model requires it

# --- Deployment secret names ---
# Configure these in your GitHub/Vercel environment secret store, never here:
# VERCEL_TOKEN
# VERCEL_ORG_ID
# VERCEL_PROJECT_ID

# --- Payments/notifications ---
# Online card payments are not wired up yet; no payment keys are required.
# Email/SMS/push providers are optional and remain disabled until configured.
