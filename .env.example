# BOOKORA AI — environment template
# Copy to .env and fill in with your own backend project values.
# Never commit a real .env file.

# --- Client-visible (safe to expose in the browser) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Server-only (never expose to the browser) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
SUPABASE_PROJECT_ID="your-project-id"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Reserved for future server-side jobs (background reminders, email/SMS
# delivery, plan metering). It BYPASSES row-level security, so it must
# never be used in this frontend app or committed to git.

# AI assistant (Lovable AI Gateway). Injected automatically on Lovable;
# required locally for the AI business assistant to answer.
LOVABLE_API_KEY=""

# --- Not configured in this project ---
# Online card payments (Stripe/Paddle) are NOT wired up. Payments are tracked
# manually in the database only. No payment keys are required or used.
